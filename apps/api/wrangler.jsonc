{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sitebot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "DEFAULT_MODEL": "openai/gpt-oss-120b",
    // Comma-separated origins allowed to call /api. Add the Pages URL before deploying.
    "DASHBOARD_ORIGIN": "http://localhost:5173"
  },
  // Secret, not listed here: GROQ_API_KEY (`wrangler secret put GROQ_API_KEY`, or .dev.vars locally).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sitebot",
      "database_id": "206e1caa-4552-4bfb-8a1e-b05b732af485",
      "migrations_dir": "migrations"
    }
  ],
  // `wrangler vectorize create sitebot-chunks --dimensions=1024 --metric=cosine`
  // Vectorize and Workers AI have no local simulator: `wrangler dev` uses the real ones.
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "sitebot-chunks", "remote": true }],
  "ai": { "binding": "AI", "remote": true },
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "sitebot-uploads" }],
  "queues": {
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "sitebot-ingest" }],
    "consumers": [{ "queue": "sitebot-ingest", "max_batch_size": 5, "max_retries": 3 }]
  },
  // Weekly re-crawl: Mondays 03:00 UTC.
  "triggers": { "crons": ["0 3 * * 1"] }
}
