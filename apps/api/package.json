{
  "name": "@sitebot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-config.mjs && wrangler dev -c wrangler.dev.jsonc",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply sitebot --local",
    "migrate:remote": "wrangler d1 migrations apply sitebot --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sitebot/shared": "*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "latest",
    "@cloudflare/workers-types": "^5.20261011.1",
    "typescript": "^5.9.0",
    "@vitest/runner": "^4.1.0",
    "@vitest/snapshot": "^4.1.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
